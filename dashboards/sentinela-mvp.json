                      },
                      "spec": {
                        "query": "from(bucket: \"metricas_iniciais\")\n    |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n    |> filter(fn: (r) =>\n      r._measurement == \"system_metrics\" and\n      r._field == \"disk_free_gib\" and\n      r.host_id == \"${host_id}\"\n    )\n    |> aggregateWindow(\n      every: v.windowPeriod,\n      fn: mean,\n      createEmpty: false\n    )\n    |> set(key: \"_field\", value: \"Disponivel\")\n    |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n    |> group(columns: [\"_field\"])"
                      }
                    },
                    "refId": "B",
                    "hidden": false

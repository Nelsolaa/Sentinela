      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Capacidade de disco",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "sentinela-influxdb"
                      },
                      "spec": {
                        "query": "from(bucket: \"metricas_iniciais\")\n    |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n    |> filter(fn: (r) =>\n      r._measurement == \"system_metrics\" and\n      r._field == \"disk_used_gib\" and\n      r.host_id == \"${host_id}\"\n    )\n    |> aggregateWindow(\n      every: v.windowPeriod,\n      fn: mean,\n      createEmpty: false\n    )\n    |> set(key: \"_field\", value: \"Usado\")\n    |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n    |> group(columns: [\"_field\"])"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {

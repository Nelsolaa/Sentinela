      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Capacidade de memoria",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "sentinela-influxdb"
                      },
                      "spec": {
                        "query": "  data =\n    from(bucket: \"metricas_iniciais\")\n      |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n      |> filter(fn: (r) =>\n        r._measurement == \"system_metrics\" and\n        r.host_id == \"${host_id}\" and\n        (\n          r._field == \"memory_total_gib\" or\n          r._field == \"memory_available_gib\"\n        )\n      )\n      |> aggregateWindow(\n        every: v.windowPeriod,\n        fn: mean,\n        createEmpty: false\n      )\n      |> pivot(\n        rowKey: [\"_time\"],\n        columnKey: [\"_field\"],\n        valueColumn: \"_value\"\n      )\n\n  usada =\n    data\n      |> map(fn: (r) => ({\n        _time: r._time,\n        _field: \"Usada\",\n        _value:\n          float(v: r.memory_total_gib) -\n          float(v: r.memory_available_gib)\n      }))\n\n  disponivel =\n    data\n      |> map(fn: (r) => ({\n        _time: r._time,\n        _field: \"Disponivel\",\n        _value: float(v: r.memory_available_gib)\n      }))\n\n  total =\n    data\n      |> map(fn: (r) => ({\n        _time: r._time,\n        _field: \"Total\",\n        _value: float(v: r.memory_total_gib)\n      }))\n\n  union(tables: [usada, disponivel, total])\n    |> group(columns: [\"_field\"])"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }

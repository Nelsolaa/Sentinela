# Copy this file to .env and fill local values as needed.

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=sentinela
INFLUXDB_BUCKET=metrics
INFLUXDB_TOKEN=change-me
INFLUXDB_TIMEOUT_MS=5000

# Sentinela API
SENTINELA_API_URL=http://127.0.0.1:8000
SENTINELA_ENV=development
SENTINELA_HOST_ID=local-host
SENTINELA_MACHINE_TYPE=host

# Service-to-service security
# Generate each key with: openssl rand -hex 32
SENTINELA_INGEST_API_KEY=replace-with-a-random-64-character-value
SENTINELA_READ_API_KEY=replace-with-a-different-random-64-character-value
SENTINELA_ALLOWED_MEASUREMENTS=system_metrics
SENTINELA_ALLOWED_TAG_KEYS=host_id,machine_type,environment,os

# HTTP hardening
SENTINELA_ALLOWED_HOSTS=127.0.0.1,localhost
SENTINELA_CORS_ORIGINS=
SENTINELA_DOCS_ENABLED=true
SENTINELA_HTTPS_ONLY=false
SENTINELA_MAX_REQUEST_BODY_BYTES=32768

# Resource limits
# memory:// requires a single API worker. Use shared storage or a proxy for replicas.
SENTINELA_RATE_LIMIT_STORAGE_URI=memory://
SENTINELA_INGEST_RATE_LIMIT=30/minute
SENTINELA_READ_RATE_LIMIT=60/minute
SENTINELA_HEALTH_RATE_LIMIT=120/minute
SENTINELA_BUFFER_MAX_ITEMS=1000

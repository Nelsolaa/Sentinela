# Copy this file to .env and replace every change-me value before starting the stack.

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ADMIN_USERNAME=admin_sentinela
INFLUXDB_ADMIN_PASSWORD=change-me-influxdb-password
INFLUXDB_ORG=sentinela_org
INFLUXDB_BUCKET=metricas_iniciais
INFLUXDB_TOKEN=change-me-influxdb-token

# Grafana
GRAFANA_ADMIN_USER=admin_grafana
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Sentinela API
SENTINELA_API_URL=http://127.0.0.1:8000
SENTINELA_ENV=development
SENTINELA_HOST_ID=local-host
